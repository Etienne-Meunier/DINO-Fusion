    "import numpy as np\n",
    "from scipy.optimize import isotonic_regression"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "c794be1e-5797-4732-84bd-295f9e40d621",
   "metadata": {},
   "outputs": [],
   "source": [
    "a = np.linspace(1, 2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "c4b12b34-58af-4140-991c-a4d3794f30e6",
   "metadata": {},
   "outputs": [],
   "source": [
